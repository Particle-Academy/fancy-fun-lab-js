{
    "name": "@particle-academy/fancy-fun-lab",
    "version": "0.1.0",
    "description": "Headless gamification engine: XP to gamed metrics, levels and weighted level groups, achievements, prizes with inventory, leaderboards and an event log with analytics. Zero runtime dependencies. The Node/TypeScript twin of the PHP particle-academy/laravel-fun-lab, held to it by shared conformance fixtures.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Particle-Academy/fancy-fun-lab-js.git"
    },
    "homepage": "https://github.com/Particle-Academy/fancy-fun-lab-js#readme",
    "bugs": "https://github.com/Particle-Academy/fancy-fun-lab-js/issues",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./sqlite": {
            "import": {
                "types": "./dist/sqlite.d.ts",
                "default": "./dist/sqlite.js"
            },
            "require": {
                "types": "./dist/sqlite.d.cts",
                "default": "./dist/sqlite.cjs"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "AGENTS.md",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist",
        "prepublishOnly": "tsup",
        "check:dist": "node scripts/check-dist.mjs"
    },
    "keywords": [
        "gamification",
        "xp",
        "levels",
        "achievements",
        "badges",
        "prizes",
        "leaderboard",
        "engagement",
        "headless",
        "fancy",
        "human-plus"
    ],
    "devDependencies": {
        "@particle-academy/fancy-conformance": "^0.49.0",
        "@types/node": "^22",
        "tsup": "^8.5.0",
        "typescript": "^5.8.0",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "overrides": {
        "esbuild": "^0.28.1",
        "source-map-js": "^1.2.2"
    }
}
